# ===========================================
# NIWMS — Natural Intellects Workforce Management System
# ===========================================
# Copy this file to .env.local and fill in the values
# NOTE: Use .env.local (not .env) to avoid Prisma's .env parser bug

# PostgreSQL Database URL (required in production)
# Get this from your database provider (Supabase, Neon, Vercel Postgres, etc.)
# Format: postgresql://username:password@host:5432/database?sslmode=require
#
# Supabase notes:
# - Direct connections (db.<project-ref>.supabase.co:5432) are IPv6-only on new
#   projects; hosts without IPv6 connectivity must use the Supavisor pooler:
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   (the exact region-prefixed pooler host is shown in Supabase → Connect)
# - Apply the schema with: bunx prisma db push --schema prisma/schema.prisma
# - The four billing plans self-seed on the first GET /api/plans request, or
#   proactively via scripts/supabase-provision.ts
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Secret for authentication (required)
# Use a long random string (e.g., generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this"

# Optional: Application URL (used for redirects, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Commercial SaaS scheduler and billing configuration
BILLING_PROVIDER="mock"
BILLING_WEBHOOK_SECRET="replace-with-provider-webhook-secret"
BILLING_CRON_SECRET="replace-with-a-long-random-secret"
# Configure these only when a real provider adapter is installed
BILLING_API_KEY=""
# Email delivery: disabled (default, fail-safe) | outbox (record deliveries in
# the platform Control Center outbox — no external service needed) | smtp
# (real sends; requires SMTP_HOST + EMAIL_FROM, optional SMTP_PORT/SMTP_SECURE/
# SMTP_USER/SMTP_PASSWORD)
EMAIL_PROVIDER="disabled"
EMAIL_API_KEY=""
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
