# ===========================================
# NIWMS — Natural Intellects Workforce Management System
# ===========================================
# Copy this file to .env.local and fill in the values
# NOTE: Use .env.local (not .env) to avoid Prisma's .env parser bug

# PostgreSQL Database URL (required in production)
# Get this from your database provider (Supabase, Neon, Vercel Postgres, etc.)
# Format: postgresql://username:password@host:5432/database?sslmode=require
#
# Supabase notes:
# - Direct connections (db.<project-ref>.supabase.co:5432) are IPv6-only on new
#   projects; hosts without IPv6 connectivity must use the Supavisor pooler:
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   (the exact region-prefixed pooler host is shown in Supabase → Connect)
# - Apply the schema with: bunx prisma db push --schema prisma/schema.prisma
# - The four billing plans self-seed on the first GET /api/plans request, or
#   proactively via scripts/supabase-provision.ts
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Secret for authentication (required)
# Use a long random string (e.g., generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this"

# Optional: Application URL (reserved; not read by current code)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Commercial SaaS scheduler and billing configuration
# Legacy placeholder from the pre-Nylon mock era (unused by Nylon integration)
BILLING_PROVIDER="mock"
# Legacy generic webhook secret (the generic /api/billing/webhook was retired
# in the Task 23 audit; the Nylon webhook uses NYLONPAY_WEBHOOK_SECRET below)
BILLING_WEBHOOK_SECRET="replace-with-provider-webhook-secret"
# Bearer for /api/internal/billing/sync + /api/internal/reminders. Vercel's
# standard CRON_SECRET is also accepted (Vercel sends it automatically), and
# JWT_SECRET is accepted as a deployment fallback.
BILLING_CRON_SECRET="replace-with-a-long-random-secret"
CRON_SECRET="replace-with-a-long-random-secret"
# Legacy placeholder from the pre-Nylon mock era (unused by Nylon integration)
BILLING_API_KEY=""

# Nylon Pay — the SOLE payment provider (server-side only, never expose to client)
# Get these from the Nylon Pay developer dashboard. Sandbox keys start npk_test_,
# production keys npk_live_. NYLONPAY_BASE_URL is only needed for custom/simulator
# endpoints — leave it UNSET for the real API.
# Webhook URL to configure in the Nylon dashboard: https://<your-domain>/api/billing/webhook/nylonpay
# The dashboard's webhook signing secret must equal NYLONPAY_WEBHOOK_SECRET
# (it is separate from NYLONPAY_API_SECRET).
NYLONPAY_API_KEY=""
NYLONPAY_API_SECRET=""
NYLONPAY_WEBHOOK_SECRET=""
# NYLONPAY_BASE_URL=""

# VAT rate applied to quotes (decimal fraction; default 0.18 = 18%)
BILLING_VAT_RATE="0.18"

# Email delivery: disabled (default, fail-safe) | outbox (record deliveries in
# the platform Control Center outbox — no external service needed) | smtp
# (real sends; requires SMTP_HOST + EMAIL_FROM, optional SMTP_PORT/SMTP_SECURE/
# SMTP_USER/SMTP_PASSWORD)
EMAIL_PROVIDER="disabled"
# Legacy placeholder (unused; email provider is selected via EMAIL_PROVIDER)
EMAIL_API_KEY=""
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
